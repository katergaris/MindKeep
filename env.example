# Questo file e' facoltativo: se non lo crei, Mindkeep genera da solo
# SESSION_SECRET, ENCRYPTION_KEY e le chiavi VAPID (notifiche push) al
# primo avvio e li salva dentro data/ (sopravvivono a riavvii e rebuild).
# Copia questo file in ".env" solo se vuoi personalizzare qualcosa
# (durata sessione, porta, chiavi tue).

# Porta su cui risponde il server dentro il container (di norma non serve cambiarla)
PORT=3000

# Porta esposta sul TUO computer (quella che apri nel browser).
# Se e' occupata, lo script di setup (setup.sh / setup.ps1) ne sceglie automaticamente
# una libera e aggiorna questo valore.
HOST_PORT=3000

# Chiave usata per firmare i cookie di sessione.
# Genera una stringa lunga e casuale, es: openssl rand -hex 32
SESSION_SECRET=cambiami-con-una-stringa-lunga-e-casuale

# Quanto dura l'accesso prima che venga richiesta di nuovo la password.
#   0  (o riga assente) = non scade mai: resti dentro finche' non premi "Esci".
#   N  = numero di giorni. Il conto riparte a ogni utilizzo, quindi vieni
#        disconnesso solo dopo N giorni in cui non apri mai Mindkeep.
# Nota: con 0 chiunque usi questo browser entra senza password. Se il computer
# e' condiviso, metti un numero (es. 7) oppure ricordati di premere "Esci".
SESSION_DAYS=0

# Passphrase usata per derivare la chiave di cifratura del vault password.
# NON perderla: senza questa passphrase le password salvate non sono recuperabili.
# Genera una stringa lunga e casuale, es: openssl rand -hex 32
ENCRYPTION_KEY=cambiami-con-una-passphrase-lunga-e-segreta

# Dove finiscono, sul TUO computer/NAS, i file caricati nel Drive.
# Di norma non serve toccarlo (resta nella cartella del progetto). Se vuoi
# salvarli altrove — es. un disco esterno o un HDD montato — metti qui il suo
# percorso, es: UPLOADS_DIR=/mnt/hdd1/mindkeep-uploads
UPLOADS_DIR=./uploads
